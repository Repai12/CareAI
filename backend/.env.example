# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env - it's already in .gitignore.

# --- Database (required) ---
# Get this from your Neon project's "Connect" dialog (Dashboard -> Connect).
# Everyone on the team should point at the SAME Neon database - see the
# "Working with a shared database" section in README.md before running
# migrations or the seed script.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Auth (required) ---
# Any long random string works for local dev. Use a real secret in production.
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Email (Resend) - optional locally, required for verification/reset/reports emails ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- AI: Gemini - optional locally, required for the AI Report Analyzer ---
GEMINI_API_KEY=

# --- AI: Groq - optional locally, required for Symptom Checker / Diet Advisor ---
GROQ_API_KEY=

# --- SMS (Textbelt) - required for real SOS / fall alerts / check-in texts to
# actually send; the app runs fine without it, just with no real SMS delivery.
# Defaults to Textbelt's free shared key ("textbelt", 1 msg/day, pooled
# globally, some destination countries blocked) - works with zero setup.
# Set to a paid Textbelt key (no phone/account verification needed to buy
# one, unlike Twilio) for reliable, unshared sending.
TEXTBELT_API_KEY=textbelt

# --- SMS (Twilio) - unused now (swapped to Textbelt above after Twilio's
# signup phone-verification kept failing), left here in case that ever
# gets resolved and the team wants to switch back. ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Daily Safety Check-in ---
# Hours after which a missed daily check-in triggers a family alert.
SAFETY_CHECKIN_TIMEOUT_HOURS=24
